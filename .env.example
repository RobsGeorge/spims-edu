APP_NAME=SPIMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=spims
DB_USERNAME=spims
DB_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail skipped in v1 bootstrap — OTP logged when MAIL_MAILER=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@spims-edu.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super Admin (seeded)
SUPERADMIN_EMAIL=robeir.george@outlook.com
SUPERADMIN_PASSWORD=Spims@Dev2026!

# Object storage (Cloudflare R2 or S3-compatible)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Optional integrations (app degrades gracefully without keys)
GOOGLE_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
VIMEO_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYMOB_API_KEY=
