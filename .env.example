APP_NAME=SPIMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo
FORCE_HTTPS=false
SEED_SAMPLE_DATA=true
SEED_DEMO_DATA=true
# Public /demo console (persona enter + re-seed). Set false to hide the trial page.
DEMO_CONSOLE=true
BACKUP_PATH=
BACKUP_RETENTION_DAYS=14

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local (Windows/dev): sqlite — create empty file at database/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production / staging (PostgreSQL 16):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=spims
# DB_USERNAME=spims
# DB_PASSWORD=

# Local: file/sync. Production: redis for cache/queue/session.
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail skipped in v1 bootstrap — OTP goes to the mail log (not laravel.log) when MAIL_MAILER=log
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_FROM_ADDRESS="noreply@spims-edu.com"
MAIL_FROM_NAME="${APP_NAME}"

# Super Admin (seeded)
SUPERADMIN_EMAIL=robeir.george@outlook.com
SUPERADMIN_PASSWORD=Spims@Dev2026!

# Object storage (Cloudflare R2 or S3-compatible)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Personal access tokens expire after this many minutes (default 43200 = 30 days).
SANCTUM_TOKEN_EXPIRATION=43200

# Optional integrations (app degrades gracefully without keys).
# *-test webhook secrets are refused in production — replace before go-live.
GOOGLE_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=zoom-test
VIMEO_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=paypal-test
PAYMOB_API_KEY=
PAYMOB_HMAC=paymob-test
CASHIER_SECRET=cashier-test
# Mock auto-complete is true only in local/testing when unset. Staging/production default is false.
PAYMENTS_MOCK_AUTO_COMPLETE=true
